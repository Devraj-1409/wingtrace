# Backend settings. All optional; defaults shown. Pass with: uvicorn ... --env-file .env

# Where reference.sqlite and flights.sqlite live.
# DATA_DIR=./data

# Identify the site to the data providers (please include a contact URL or email when public).
# USER_AGENT=wingtrace/0.1 (non-commercial hobby project)

# Seconds between requests to adsb.lol (the client adapts between min and start).
# ADSBLOL_MIN_INTERVAL=6
# ADSBLOL_START_INTERVAL=8

# adsb.fi: personal, non-commercial use only, 1 request/second.
# ADSBFI_ENABLED=true
# ADSBFI_MIN_INTERVAL=1.2
# ADSBFI_START_INTERVAL=1.5

# World-wide sweep by aircraft type (turn off to only show areas people zoom into).
# GLOBAL_SWEEP=true

# Hide military aircraft (LADD / PIA aircraft are always hidden).
# HIDE_MILITARY=true

# Days of recorded flight paths to keep (they're only shown while a flight is live).
# RETENTION_DAYS=2

# Import yesterday's full-detail history from adsb.lol daily (~3 GB download per day).
# Only useful for flight replay, which the website doesn't offer: leave off.
# AUTO_IMPORT=false

# Requests per minute allowed from one visitor.
# CLIENT_REQUESTS_PER_MINUTE=240

# Production: serve the built frontend from this folder (same origin, no CORS needed).
# FRONTEND_DIST=../frontend/dist

# Frontend hosted elsewhere (e.g. GitHub Pages): comma-separated allowed origins.
# CORS_ORIGINS=https://yourname.github.io
