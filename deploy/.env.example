# Domain pointing at this server, e.g. a free DuckDNS name: wingtrace.duckdns.org
API_DOMAIN=

# Your GitHub Pages address (the site that calls this API).
CORS_ORIGINS=https://yourname.github.io

# Identify the site to adsb.lol / adsb.fi, with a way to contact you.
USER_AGENT=wingtrace/0.1 (+https://yourname.github.io/wingtrace)

# Days of recorded flight paths to keep (they're only shown while a flight is live).
RETENTION_DAYS=2

# Daily full-history import (~3 GB download/day): only useful for replay, which the site doesn't offer.
AUTO_IMPORT=false
